# ---- 密钥与本地配置 ----
.env
*.env
!.env.example

# ---- 虚拟环境 ----
.venv/
venv/

# ---- 运行时产物 ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
runtime/

# ---- 向量库与上传件（体积大、可重建；公开仓库时不提交）----
