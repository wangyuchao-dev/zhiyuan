# ---- 密钥与本地配置 ----
.env
*.env
!.env.example

# ---- 虚拟环境 ----
.venv/
venv/

# ---- 运行时产物 ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
runtime/

# ---- 向量库与上传件（体积大、可重建；公开仓库时不提交）----
indexing/chroma_db/
uploads/*.pdf

# ---- 样例语料：故意入库 ----
# samples/ 是仓库自带的测试语料（无敏感信息），别人 clone 下来要能直接跑冒烟测试；
# 若哪天样例变大，应改用 Git LFS，而不是把它从仓库里排除。
# !samples/*.pdf


# ---- 评测产物（样例报告保留，逐次结果不入库）----
eval/results/*.json

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ---- 工具缓存 ----
.ruff_cache/
.mypy_cache/

# ---- 编辑器 ----
.idea/
.vscode/
*.swp
.DS_Store
